<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="AetherShellBrush" Color="#EAF3FC" />
    <SolidColorBrush x:Key="AetherHeaderBrush" Color="#E1EFFF" />
    <SolidColorBrush x:Key="AetherPanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AetherSubtleBrush" Color="#F5F9FE" />
    <SolidColorBrush x:Key="AetherBorderBrush" Color="#D8E5F3" />
    <SolidColorBrush x:Key="AetherInkBrush" Color="#142E4D" />
    <SolidColorBrush x:Key="AetherMutedBrush" Color="#5B708A" />
    <SolidColorBrush x:Key="AetherBlueBrush" Color="#096DE0" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Malgun Gothic, Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource AetherInkBrush}" />
    <Setter Property="Background" Value="{DynamicResource AetherShellBrush}" />
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AetherInkBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AetherMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AetherMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="21" />
  </Style>

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource AetherInkBrush}" />
    <Setter Property="Background" Value="{DynamicResource AetherPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#EAF4FF" />
    <Setter Property="BorderBrush" Value="#A9CFF7" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D5E9FF" />
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBlueBrush}" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.42" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AetherBlueBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBlueBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#005FCC" />
    <Setter Property="BorderBrush" Value="#005FCC" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0752AD" />
    <Setter Property="BorderBrush" Value="#0752AD" />
  </Style>
  <Style Selector="Button.icon-action">
    <Setter Property="Width" Value="36" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Background" Value="#F5FAFF" />
  </Style>
  <Style Selector="Button.row-action">
    <Setter Property="Width" Value="34" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource AetherPanelBrush}" />
  </Style>
  <Style Selector="Button.group-action">
    <Setter Property="Width" Value="34" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="#EAF4FF" />
    <Setter Property="BorderBrush" Value="#C5DDF6" />
  </Style>
  <Style Selector="Border.row-indicator">
    <Setter Property="Background" Value="#ECF5FF" />
    <Setter Property="BorderBrush" Value="#C7DFF8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Border.group-indicator">
    <Setter Property="Background" Value="#E2F0FF" />
    <Setter Property="BorderBrush" Value="#B8D5F4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Border.lifecycle-dialog">
    <Setter Property="Background" Value="{DynamicResource AetherPanelBrush}" />
    <Setter Property="BorderBrush" Value="#B8D5F4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="28,24" />
  </Style>
  <Style Selector="TextBlock.lifecycle-title">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AetherInkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.lifecycle-message">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource AetherMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="21" />
  </Style>
  <Style Selector="Border.lifecycle-target">
    <Setter Property="Background" Value="#F0F7FF" />
    <Setter Property="BorderBrush" Value="#D8E5F3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style Selector="TextBlock.lifecycle-target-name">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AetherInkBrush}" />
  </Style>
  <Style Selector="TextBlock.lifecycle-busy">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AetherBlueBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.lifecycle-error">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#A52A2A" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.lifecycle-choice">
    <Setter Property="MinWidth" Value="112" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Button.structure-tool">
    <Setter Property="MinWidth" Value="106" />
    <Setter Property="MinHeight" Value="66" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="#FAFCFF" />
  </Style>
  <Style Selector="TabControl.tool-mode">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TabControl.tool-mode TabItem">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Foreground" Value="{DynamicResource AetherMutedBrush}" />
  </Style>
  <Style Selector="TabControl.tool-mode TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource AetherBlueBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBox.palette-search">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="ListBox.palette-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="152" />
    <Setter Property="MaxHeight" Value="252" />
  </Style>
  <Style Selector="ListBox.palette-list ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.palette-list ListBoxItem:selected Border.palette-entry">
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBlueBrush}" />
    <Setter Property="Background" Value="#EEF6FF" />
  </Style>
  <Style Selector="Border.palette-entry">
    <Setter Property="Background" Value="#FAFCFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="5,5" />
  </Style>
  <Style Selector="Border.palette-glyph-card">
    <Setter Property="Background" Value="#F0F6FD" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="Border.palette-detail">
    <Setter Property="Background" Value="#F0F7FF" />
    <Setter Property="BorderBrush" Value="#C7DFF8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,7" />
  </Style>
  <Style Selector="TextBlock.palette-meta">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="Foreground" Value="{DynamicResource AetherMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.palette-error">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="#9A3B34" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.palette-insert">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.palette-compact-action">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBlueBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource AetherPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="Border.output-preview-surface">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.output-preview-setting-card">
    <Setter Property="Background" Value="#F5F9FE" />
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="9,8" />
  </Style>
  <Style Selector="Border.output-preview-status-card">
    <Setter Property="Background" Value="#ECF5FF" />
    <Setter Property="BorderBrush" Value="#C7DFF8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="9,8" />
  </Style>
  <Style Selector="Border.output-preview-footer">
    <Setter Property="Background" Value="{DynamicResource AetherPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="TabControl.inspector">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TabControl.inspector TabItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Foreground" Value="{DynamicResource AetherMutedBrush}" />
  </Style>
  <Style Selector="TabControl.inspector TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource AetherBlueBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.structure-clear-panel">
    <Setter Property="Background" Value="#F5F9FE" />
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="TreeView.structure-tree">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TreeView.structure-tree TreeViewItem">
    <Setter Property="Padding" Value="1" />
    <Setter Property="Margin" Value="0,0,1,2" />
    <Setter Property="IsExpanded" Value="True" />
  </Style>
  <Style Selector="TreeView.structure-tree Border.structure-tree-entry">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <!-- TreeViewItem의 Fluent 선택 표시는 각 항목 헤더에 적용한다. 내부 Border에 하위 선택 상태가 전파되지 않게 둔다. -->

  <Style Selector="ListBox.library-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.library-list ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.library-list ListBoxItem:selected Border.library-entry">
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBlueBrush}" />
    <Setter Property="Background" Value="#EEF6FF" />
  </Style>
  <Style Selector="Border.library-entry">
    <Setter Property="Background" Value="#FAFCFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="9,8" />
  </Style>
  <Style Selector="Border.library-entry.recovery-entry">
    <Setter Property="Background" Value="#F5F9FE" />
  </Style>
  <Style Selector="Border.library-preview">
    <Setter Property="Background" Value="#F2F7FD" />
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Border.library-diagnostic">
    <Setter Property="Background" Value="#FFF7F4" />
    <Setter Property="BorderBrush" Value="#E8C6BA" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="TextBlock.library-diagnostic-text">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="#8C382D" />
  </Style>
  <Style Selector="Border.library-confirmation">
    <Setter Property="Background" Value="#FFF9F3" />
    <Setter Property="BorderBrush" Value="#E7C9A9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Border.library-badge">
    <Setter Property="Background" Value="#EAF4FF" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.library-badge TextBlock">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="Foreground" Value="{DynamicResource AetherBlueBrush}" />
  </Style>
  <Style Selector="TextBlock.library-path">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource AetherMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.library-error">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="#9A3B34" />
  </Style>
  <Style Selector="Border.library-notice">
    <Setter Property="Background" Value="#EAF4FF" />
    <Setter Property="BorderBrush" Value="#C7DFF8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="9,7" />
  </Style>
  <Style Selector="Border.library-notice TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="#245B91" />
  </Style>
  <Style Selector="TextBlock.library-preview-text">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource AetherInkBrush}" />
  </Style>
  <Style Selector="Button.library-action">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.library-action.destructive">
    <Setter Property="Foreground" Value="#8A3D43" />
    <Setter Property="Background" Value="#FFF4F3" />
    <Setter Property="BorderBrush" Value="#E8C8C8" />
  </Style>
  <Style Selector="Border.property-field">
    <Setter Property="Background" Value="{DynamicResource AetherPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="Button.property-action">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.property-action.destructive">
    <Setter Property="Foreground" Value="#8A3D43" />
    <Setter Property="Background" Value="#FFF4F3" />
    <Setter Property="BorderBrush" Value="#E8C8C8" />
  </Style>

  <Style Selector="Expander.code-panel">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource AetherPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AetherBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.code-view-frame">
    <Setter Property="Background" Value="#F6FAFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0,0,8,8" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="SelectableTextBlock.code-view">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#21496F" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="ToggleButton.code-highlight-toggle">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
</Styles>
